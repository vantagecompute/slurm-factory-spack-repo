# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Generated at build time by @vantagecompute/docusaurus-plugin-pydoc from the
# docstrings in spack_repo/slurm_factory/packages/*/package.py.
#
# Deliberately not committed, so these pages always come from current source.
# A committed generated page can outlive the docstring it came from, and a
# reader cannot see that it has.
docs/package-reference/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Yarn 4 (the binary comes from corepack, so nothing under .yarn is committed)
.yarn/*
!.yarn/patches
.pnp.*
