{
  "name": "slurm-factory-spack-repo-docs",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "gen-pydoc": "node node_modules/@vantagecompute/docusaurus-plugin-pydoc/src/generate.js --project-root .. --output-dir ./docs/package-reference --modules $(cd ../spack_repo/slurm_factory/packages && ls -d */ | tr -d / | sed 's/.*/spack_repo.slurm_factory.packages.&.package/' | paste -sd, -) --label 'Package Reference'"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@vantagecompute/docusaurus-plugin-pydoc": "^0.1.2",
    "@vantagecompute/docusaurus-theme": "^0.5.6",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "docusaurus-plugin-llms": "^0.6.1",
    "typescript": "^7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=26.0"
  },
  "resolutions": {
    "docusaurus-plugin-llms/minimatch": "^9.0.7",
    "docusaurus-plugin-llms/yaml": "^2.8.3",
    "@docusaurus/core/tinypool": "^2.1.2"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
